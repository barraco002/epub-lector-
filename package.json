{
  "name": "lunaria",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "Lunaria — lector de EPUB con temas, tipografía editable, pomodoro, sonidos ambientales y gamificación",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "build:all": "npm run build && npm run build:single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "fonts": "node scripts/gen-fonts.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run build && cap sync android && cd android && ./gradlew assembleRelease",
    "fixtures": "node tests/fixtures/make-fixtures.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@fontsource-variable/alegreya": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/bitter": "5.3.0",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/crimson-pro": "5.3.0",
    "@fontsource-variable/eb-garamond": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/gelasio": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lexend": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/merriweather": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/noto-serif": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource-variable/vollkorn": "5.3.0",
    "@fontsource/charis-sil": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/ia-writer-quattro": "5.3.0",
    "@fontsource/libre-baskerville": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "@preact/signals": "2.11.3",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "lucide-preact": "1.58.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "happy-dom": "21.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
