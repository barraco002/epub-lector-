<?xml version="1.0" encoding="utf-8"?>
<!-- Copia en la nube (Android 12+): solo el resumen ligero de progreso, que siempre cabe en la
     cuota. El paso directo a un móvil nuevo no se limita: se lleva también los libros. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="respaldo" />
    </cloud-backup>
</data-extraction-rules>
