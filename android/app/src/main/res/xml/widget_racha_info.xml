<?xml version="1.0" encoding="utf-8"?>
<!-- Se redibuja cada 6 h solo para el cambio de día; los datos los envía la app al leer -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="70dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="21600000"
    android:initialLayout="@layout/widget_racha"
    android:previewLayout="@layout/widget_racha"
    android:description="@string/widget_desc"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
